static func buildings(stage: int) -> Array[Rect2]:
	var result: Array[Rect2] = []
	if stage == 0:
		for x in range(0, 2400, 320):
			for y in range(0, 1600, 320):
				result.append(Rect2(x, y, 116, 55))
		result.append(Rect2(1300, 683, 138, 66))
	elif stage == 1:
		for x in range(120, 2300, 420):
			for y in range(80, 1500, 340):
				result.append(Rect2(x, y, 75, 130))
	else:
		for x in range(40, 2300, 360):
			for y in range(80, 1500, 260):
				result.append(Rect2(x, y, 175, 62))
	return result
